NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/child_rehab_crm?schema=public
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5
SMS_ENABLED=false

# Super Admin Initial Credentials
SUPER_ADMIN_PHONE=+998901000001
SUPER_ADMIN_PASSWORD=replace-with-a-unique-12-character-minimum-password
SUPER_ADMIN_FULL_NAME=Bosh Administrator (Super)
SUPER_ADMIN_EMAIL=admin@massaj.uz
SWAGGER_ENABLED=false
